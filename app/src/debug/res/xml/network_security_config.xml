<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG builds only: allow plain http:// to ANY host, so the app can reach the
    local backend from a physical phone (e.g. http://192.168.1.20:8000).
    Files in src/debug/ replace the same-named file in src/main/ for debug builds;
    release builds keep the stricter src/main version.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
