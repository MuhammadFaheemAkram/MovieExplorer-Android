<?xml version="1.0" encoding="utf-8"?>
<!--
    Android blocks plain http:// traffic by default (only https:// is allowed).
    Our local FastAPI backend runs on http://, so we allow cleartext ONLY for
    the hosts used during local development:
      - 10.0.2.2  : the Android emulator's alias for the Mac's localhost
      - localhost / 127.0.0.1 : e.g. with `adb reverse tcp:8000 tcp:8000`
    Debug builds override this file (src/debug/res/xml) to also allow a
    physical phone to reach the Mac by its Wi-Fi IP address.
    A production backend must use https://, and then this file is not needed.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
